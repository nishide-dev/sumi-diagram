{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.worktrees",
      "!.claude",
      "!.sumi",
      "!**/dist",
      "!**/node_modules",
      "!schema/*.schema.json",
      "!assets/fonts",
      "!examples/**/*.svg",
      "!research/*/out",
      "!research/188-badges-emoji-bowtie/*.svg",
      "!docs/gallery",
      "!tests/fixtures/lint-output",
      "!tests/fixtures/layout",
      "!tests/fixtures/pptx-editable-japanese.svg",
      "!tests/fixtures/assets/*.svg",
      "!research/*/.tools",
      "!research/*/out",
      "!research/*/results",
      "!research/*/wasm/target",
      "!native/*/target",
      "!native/*/vendor",
      "!native/*/licenses"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
