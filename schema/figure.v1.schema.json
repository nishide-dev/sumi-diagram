{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "requires": {
      "description": "Minimum Sumi version as a semver range, e.g. \">=0.4.0\".",
      "type": "string",
      "minLength": 1
    },
    "figure": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string"
        },
        "theme": {
          "default": "minimal",
          "description": "Built-in theme name.",
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "default": "paper-single",
          "description": "Built-in output profile name.",
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "default": {},
          "type": "object",
          "properties": {
            "engine": {
              "description": "auto: D2/ELK. structured: arrange trees and attach. Omitted means structured if arrange is given, else auto.",
              "type": "string",
              "enum": [
                "auto",
                "structured"
              ]
            },
            "direction": {
              "default": "right",
              "description": "Flow direction of the root layout (auto engine only).",
              "type": "string",
              "enum": [
                "right",
                "down",
                "left",
                "up"
              ]
            },
            "arrange": {
              "description": "Structured layout: places the root-level nodes and groups.",
              "$ref": "#/$defs/ArrangeBox"
            },
            "align": {
              "description": "Structured layout: elements of different arrange trees placed on one horizontal (y) or vertical (x) line.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/AlignConstraint"
              }
            },
            "fanIn": {
              "description": "Edges from different elements entering the same point of an element without an anchor: merge joins them into one line, spread enters them side by side in the order of their other ends. Omitted means merge (structured layout only).",
              "type": "string",
              "enum": [
                "merge",
                "spread"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "groups": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "label": {
            "default": "",
            "description": "Plain text; newlines break lines. Empty or omitted means no label.",
            "type": "string"
          },
          "labelAt": {
            "description": "Where the label sits inside the group's border. Omitted means top (top centre) in structured layout and top-left in auto layout.",
            "type": "string",
            "enum": [
              "top-left",
              "top",
              "top-right",
              "bottom-left",
              "bottom",
              "bottom-right"
            ]
          },
          "caption": {
            "description": "Text drawn centred below the group's border, e.g. \"(a) encoder\". Drawn as a label with the reserved ID <id>-caption.",
            "type": "string",
            "minLength": 1
          },
          "component": {
            "default": "container",
            "description": "Component reference (kind: group).",
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "default": "default",
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "description": "Color category from the theme's palette (e.g. a pastel fill in the color theme, a gray step in monochrome themes). Omitted means none.",
            "type": "string",
            "enum": [
              "gray",
              "red",
              "orange",
              "yellow",
              "green",
              "blue",
              "purple",
              "pink"
            ]
          },
          "group": {
            "description": "Parent group ID. Omitted means the root (or, in structured layout, the group whose arrange lists it).",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "arrange": {
            "description": "Structured layout: places the group's children; listed elements become its children.",
            "$ref": "#/$defs/ArrangeBox"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "component": {
            "type": "string",
            "minLength": 1,
            "description": "Component reference (kind: node), e.g. `box` or `sumi/box`."
          },
          "label": {
            "default": "",
            "description": "Plain text; newlines break lines. Empty or omitted means no label.",
            "type": "string"
          },
          "icon": {
            "description": "A bundled icon drawn in place of the label, as <set>/<name>, e.g. tabler/wave-sine. Drawn in the node's text color.",
            "type": "string",
            "maxLength": 80,
            "pattern": "^([a-z][a-z0-9]*)\\/([a-z0-9]+(?:-[a-z0-9]+)*)$"
          },
          "variant": {
            "default": "default",
            "type": "string",
            "minLength": 1
          },
          "tone": {
            "description": "Color category from the theme's palette (e.g. a pastel fill in the color theme, a gray step in monochrome themes). Omitted means none.",
            "type": "string",
            "enum": [
              "gray",
              "red",
              "orange",
              "yellow",
              "green",
              "blue",
              "purple",
              "pink"
            ]
          },
          "props": {
            "description": "Component props, validated against the component manifest.",
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "group": {
            "description": "Containing group ID. Omitted means the root (or, in structured layout, the group whose arrange lists it).",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "attach": {
            "description": "Structured layout: place this node beside another element instead of in an arrange tree.",
            "type": "object",
            "properties": {
              "to": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                "description": "The node or group to place this node beside."
              },
              "side": {
                "type": "string",
                "enum": [
                  "north",
                  "east",
                  "south",
                  "west"
                ],
                "description": "The side of the target to place this node on."
              },
              "gap": {
                "description": "Space between the target and this node. Omitted means 0.",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(0|\\d+(\\.\\d+)?(mm|cm|in|pt))$"
                  },
                  {
                    "const": 0
                  }
                ]
              }
            },
            "required": [
              "to",
              "side"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "component"
        ],
        "additionalProperties": false
      }
    },
    "edges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Optional edge ID (separate ID space from nodes and groups).",
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "description": "Source node or group ID."
          },
          "fromAnchor": {
            "description": "Where the edge leaves the source (structured layout only).",
            "type": "string",
            "pattern": "^(north|east|south|west)(?::(0(?:\\.\\d+)?|1(?:\\.0+)?))?$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "description": "Target node or group ID."
          },
          "toAnchor": {
            "description": "Where the edge enters the target (structured layout only).",
            "type": "string",
            "pattern": "^(north|east|south|west)(?::(0(?:\\.\\d+)?|1(?:\\.0+)?))?$"
          },
          "label": {
            "default": "",
            "description": "Plain text; newlines break lines. Empty or omitted means no label.",
            "type": "string"
          },
          "labelAt": {
            "description": "Where along the route the label sits: beside the first segment (start), the longest segment (middle) or the last segment (end). Omitted means next to the arrowhead, or the middle of a line without arrowheads (structured layout only).",
            "type": "string",
            "enum": [
              "start",
              "middle",
              "end"
            ]
          },
          "labelSide": {
            "description": "Which side of the line the label sits on, facing from the source to the target. Omitted means above a horizontal segment and right of a vertical one, or the other side when that is clear (structured layout only).",
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "component": {
            "default": "arrow",
            "description": "Component reference (kind: edge).",
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "default": "default",
            "type": "string",
            "minLength": 1
          },
          "props": {
            "description": "Component props, validated against the component manifest.",
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "description": "Arbitrary JSON-compatible data; not interpreted.",
      "$ref": "#/$defs/JsonValue"
    }
  },
  "required": [
    "version",
    "figure"
  ],
  "additionalProperties": false,
  "title": "Sumi figure (schema v1)",
  "$defs": {
    "ArrangeBox": {
      "type": "object",
      "properties": {
        "stack": {
          "type": "object",
          "properties": {
            "direction": {
              "default": "down",
              "type": "string",
              "enum": [
                "down",
                "up"
              ]
            },
            "gap": {
              "description": "Space between items. Omitted means the theme/profile default.",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|\\d+(\\.\\d+)?(mm|cm|in|pt))$"
                },
                {
                  "const": 0
                }
              ]
            },
            "align": {
              "description": "Cross-axis alignment of the items. Omitted inherits from an enclosing box on the same axis.",
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "stretch"
              ]
            },
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  {
                    "$ref": "#/$defs/ArrangeBox"
                  }
                ]
              },
              "description": "Node or group IDs, or nested stack / row boxes."
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        "row": {
          "type": "object",
          "properties": {
            "direction": {
              "default": "right",
              "type": "string",
              "enum": [
                "right",
                "left"
              ]
            },
            "gap": {
              "description": "Space between items. Omitted means the theme/profile default.",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(0|\\d+(\\.\\d+)?(mm|cm|in|pt))$"
                },
                {
                  "const": 0
                }
              ]
            },
            "align": {
              "description": "Cross-axis alignment of the items. Omitted inherits from an enclosing box on the same axis.",
              "type": "string",
              "enum": [
                "start",
                "center",
                "end",
                "stretch"
              ]
            },
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  },
                  {
                    "$ref": "#/$defs/ArrangeBox"
                  }
                ]
              },
              "description": "Node or group IDs, or nested stack / row boxes."
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "A stack (vertical) or row (horizontal) of items.",
      "minProperties": 1,
      "maxProperties": 1
    },
    "AlignConstraint": {
      "type": "object",
      "properties": {
        "x": {
          "description": "Node or group IDs whose x (center, left or right edge) is made equal.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "y": {
          "description": "Node or group IDs whose y (center, top or bottom edge) is made equal.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        },
        "at": {
          "description": "Which coordinate: center (default), start (top / left) or end (bottom / right).",
          "type": "string",
          "enum": [
            "center",
            "start",
            "end"
          ]
        }
      },
      "additionalProperties": false,
      "description": "Elements of any arrange trees placed on one line (structured layout only).",
      "oneOf": [
        {
          "required": [
            "x"
          ]
        },
        {
          "required": [
            "y"
          ]
        }
      ]
    },
    "JsonValue": {
      "$ref": "#/$defs/__schema0"
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
