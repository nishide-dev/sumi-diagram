{
  "name": "sumi-diagram",
  "version": "0.1.0",
  "description": "Diagram-as-Code CLI that builds diagrams from predefined components and a design system",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "sumi": "./src/cli/index.ts"
  },
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "schema:gen": "bun scripts/gen-schema.ts",
    "schema:check": "bun scripts/gen-schema.ts --check",
    "d2:install": "bun scripts/install-d2.ts",
    "example:render": "bun scripts/render-example.ts",
    "gallery": "bun scripts/gallery.ts",
    "gallery:check": "bun scripts/gallery.ts --check",
    "commitlint": "bun scripts/commitlint.ts",
    "release:build": "bun scripts/build-release.ts",
    "release:smoke": "bun scripts/smoke-release.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.3.14",
    "@types/semver": "7.8.0",
    "typescript": "7.0.2"
  }
}
