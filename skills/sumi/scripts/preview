#!/bin/sh
# Rasterize a rendered Sumi SVG to a PNG for visual inspection and print the
# PNG's path. Usage: preview [-o <out.png>] <figure.svg> [size-in-px, default 1600]
#
# The PNG is written next to the SVG (figure.svg -> figure.png, overwriting an
# existing figure.png) unless -o/--out names another .png path. Missing output
# directories are created.
#
# macOS: Quick Look (`qlmanage`), which uses the fonts embedded in the SVG.
#   Quick Look thumbnails are square and crop the rest, so the figure is
#   wrapped in a square SVG (referencing it by file URL) and scaled to fit;
#   the figure is placed centred at its own aspect ratio and the
#   square is cropped to it with `sips` (skipped when `sips` or the SVG's
#   viewBox is unavailable).
# Elsewhere: headless Chrome / Chromium / Edge if installed (`$SUMI_CHROME`
#   names the binary), which also uses the embedded fonts. Else `rsvg-convert`
#   (librsvg), which ignores them: bold looks regular and a fallback face is
#   drawn, so a warning is printed; judge layout, not typography or weights.
# `SUMI_PREVIEW_TOOL=qlmanage|chrome|rsvg-convert` forces one renderer.
#
# On success only the PNG is written; on failure nothing is left behind.
set -eu
usage() {
  echo "usage: preview [-o <out.png>] <figure.svg> [size]" >&2
  exit 2
}
dest=
while [ $# -gt 0 ]; do
  case $1 in
    -o | --out)
      [ $# -ge 2 ] || usage
      dest=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *) break ;;
  esac
done
if [ $# -lt 1 ] || [ $# -gt 2 ] || [ ! -f "$1" ]; then usage; fi
size=${2:-1600}
case $size in
  '' | *[!0-9]*)
    echo "preview: size must be a positive integer" >&2
    exit 2
    ;;
esac

chrome=
find_chrome() {
  if [ -n "${SUMI_CHROME:-}" ]; then
    if [ -x "$SUMI_CHROME" ] && [ ! -d "$SUMI_CHROME" ]; then
      chrome=$SUMI_CHROME
    else
      echo "preview: warning: SUMI_CHROME is not an executable file: $SUMI_CHROME" >&2
    fi
    return 0
  fi
  for c in google-chrome google-chrome-stable chromium chromium-browser chrome microsoft-edge; do
    if command -v "$c" >/dev/null 2>&1; then
      chrome=$(command -v "$c")
      return 0
    fi
  done
  for c in "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
    "/Applications/Chromium.app/Contents/MacOS/Chromium" \
    "/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"; do
    if [ -x "$c" ]; then
      chrome=$c
      return 0
    fi
  done
  return 0
}
tool=${SUMI_PREVIEW_TOOL:-}
case $tool in
  qlmanage | rsvg-convert) ;;
  chrome) find_chrome ;;
  '')
    if command -v qlmanage >/dev/null 2>&1; then
      tool=qlmanage
    else
      find_chrome
      if [ -n "$chrome" ]; then
        tool=chrome
      elif command -v rsvg-convert >/dev/null 2>&1; then
        tool=rsvg-convert
      fi
    fi
    ;;
  *)
    echo "preview: SUMI_PREVIEW_TOOL must be qlmanage, chrome or rsvg-convert" >&2
    exit 2
    ;;
esac
if [ "$tool" = chrome ] && [ -z "$chrome" ]; then
  echo "preview: no Chrome / Chromium / Edge found" >&2
  exit 1
fi
if [ -z "$tool" ]; then
  echo "preview: none of qlmanage (macOS), Chrome / Chromium or rsvg-convert is available" >&2
  exit 1
fi

svg_dir=$(CDPATH='' cd -- "$(dirname -- "$1")" && pwd)
svg_abs="$svg_dir/$(basename -- "$1")"
tmp=${TMPDIR:-/tmp}
name=$(basename -- "$1" .svg)
if [ -z "$dest" ]; then dest="$svg_dir/$name.png"; fi
case $dest in
  *.png) ;;
  *)
    echo "preview: the output path must end in .png" >&2
    exit 2
    ;;
esac
if [ -d "$dest" ]; then
  echo "preview: $dest is a directory" >&2
  exit 2
fi
out=$(mktemp -d "${tmp%/}/sumi-preview.XXXXXX")
cleanup() {
  status=$?
  if [ "$status" -ne 0 ]; then rm -rf "$out"; fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

if [ "$tool" = qlmanage ]; then
  # A percent-encoded file URL (spaces, '#', '%', non-ASCII), then escaped
  # for an XML attribute ('&', '<', '>', quotes). Uses Bun or Node.js, else
  # Python 3: outside a Sumi source checkout neither JS runtime may exist.
  js='
    const { pathToFileURL } = require("node:url");
    const url = pathToFileURL(process.env.SUMI_PREVIEW_PATH).href;
    const xml = { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'\''": "&apos;" };
    process.stdout.write(url.replace(/[&<>"'\'']/g, (c) => xml[c]));
  '
  py='
import os, pathlib, sys
url = pathlib.Path(os.environ["SUMI_PREVIEW_PATH"]).as_uri()
xml = {"&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", chr(39): "&apos;"}
sys.stdout.write("".join(xml.get(c, c) for c in url))
'
  if command -v bun >/dev/null 2>&1; then
    href=$(SUMI_PREVIEW_PATH="$svg_abs" bun -e "$js")
  elif command -v node >/dev/null 2>&1; then
    href=$(SUMI_PREVIEW_PATH="$svg_abs" node -e "$js")
  elif command -v python3 >/dev/null 2>&1; then
    href=$(SUMI_PREVIEW_PATH="$svg_abs" python3 -I -c "$py")
  else
    echo "preview: needs bun, node or python3 to build the file URL" >&2
    exit 1
  fi
  # Figure box inside the square: the viewBox's aspect ratio, centred, so that
  # a centred crop with `sips` (macOS) leaves just the figure. Without `sips`
  # or a viewBox the figure fills the square (letterboxed by Quick Look).
  fx=0 fy=0 fw=$size fh=$size crop=
  if command -v sips >/dev/null 2>&1; then
    vb=$(head -c 8192 "$svg_abs" | tr '\n\t,' '   ' |
      awk '{ if (match($0, /<svg[^>]*>/)) print substr($0, RSTART, RLENGTH) }' |
      sed -n 's/.* viewBox="\([^"]*\)".*/\1/p')
    # shellcheck disable=SC2086
    set -- $vb
    if [ $# -eq 4 ]; then
      box=$(awk -v w="$3" -v h="$4" -v s="$size" 'BEGIN {
        if (w > 0 && h > 0) {
          if (w >= h) { bw = s; bh = int(s * h / w + 0.5) }
          else { bh = s; bw = int(s * w / h + 0.5) }
          if (bw < 1) bw = 1
          if (bh < 1) bh = 1
          printf "%d %d %d %d", int((s - bw) / 2), int((s - bh) / 2), bw, bh
        }
      }')
      if [ -n "$box" ]; then
        # shellcheck disable=SC2086
        set -- $box
        fx=$1 fy=$2 fw=$3 fh=$4 crop=$box
      fi
    fi
  fi
  cat >"$out/figure.svg" <<EOF
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 $size $size" width="$size" height="$size"><rect width="$size" height="$size" fill="#ffffff"/><image href="$href" xlink:href="$href" x="$fx" y="$fy" width="$fw" height="$fh"/></svg>
EOF
  qlmanage -t -s "$size" -o "$out" "$out/figure.svg" >/dev/null 2>&1
  rm -f "$out/figure.svg"
  mv "$out/figure.svg.png" "$out/figure.png"
  if [ -n "$crop" ]; then
    # Best effort: keep the full square if cropping fails.
    sips -c "$fh" "$fw" "$out/figure.png" --out "$out/cropped.png" >/dev/null 2>&1 &&
      mv "$out/cropped.png" "$out/figure.png" || rm -f "$out/cropped.png"
  fi
elif [ "$tool" = chrome ]; then
  # The SVG is inlined in a page sized to its viewBox (larger side = size px), so
  # the embedded fonts are used and the PNG has the figure's own aspect ratio.
  vb=$(head -c 8192 "$svg_abs" | tr '\n\t,' '   ' |
    awk '{ if (match($0, /<svg[^>]*>/)) print substr($0, RSTART, RLENGTH) }' |
    sed -n 's/.* viewBox="\([^"]*\)".*/\1/p')
  # shellcheck disable=SC2086
  set -- $vb
  fw=$size fh=$size
  if [ $# -eq 4 ]; then
    box=$(awk -v w="$3" -v h="$4" -v s="$size" 'BEGIN {
      if (w > 0 && h > 0) {
        if (w >= h) { bw = s; bh = int(s * h / w + 0.5) }
        else { bh = s; bw = int(s * w / h + 0.5) }
        if (bw < 1) bw = 1
        if (bh < 1) bh = 1
        printf "%d %d", bw, bh
      }
    }')
    if [ -n "$box" ]; then
      # shellcheck disable=SC2086
      set -- $box
      fw=$1 fh=$2
    fi
  fi
  {
    printf '<!doctype html><meta charset="utf-8"><style>html,body{margin:0;background:#fff}body>svg{display:block;width:%spx;height:%spx}</style>\n' "$fw" "$fh"
    cat "$svg_abs"
  } >"$out/page.html"
  set -- --headless --disable-gpu --no-sandbox --hide-scrollbars \
    --user-data-dir="$out/profile" --default-background-color=FFFFFFFF \
    --window-size="$fw,$fh" --screenshot="$out/figure.png" "file://$out/page.html"
  if command -v setsid >/dev/null 2>&1; then
    # On Linux CI the script was seen ending with 130 (its INT/TERM trap) while
    # Chrome shut down, probably Chrome signalling its process group. Run Chrome
    # in its own session, in the background so this shell's traps still run at
    # once: an interrupt is forwarded to Chrome's process group before exiting.
    # The trap is set before the launch and reads `$!` (set as soon as the job
    # starts; this is the script's only background job), so no signal can
    # arrive between starting Chrome and being able to forward to it.
    trap 'if [ -n "${!:-}" ]; then kill -TERM -- "-$!" 2>/dev/null || kill -TERM "$!" 2>/dev/null; fi; exit 130' INT TERM
    setsid "$chrome" "$@" >/dev/null 2>&1 &
    wait "$!" || true
    trap 'exit 130' INT TERM
  else
    "$chrome" "$@" >/dev/null 2>&1 || true
  fi
  rm -rf "$out/profile" "$out/page.html"
  if [ ! -s "$out/figure.png" ]; then
    echo "preview: $chrome failed to rasterize the SVG" >&2
    exit 1
  fi
else
  echo "preview: warning: rsvg-convert ignores the fonts embedded in the SVG, so bold looks regular and a fallback face is drawn; judge layout only, not typography or weights (install Chrome or Chromium for a faithful preview)" >&2
  rsvg-convert -a -w "$size" -h "$size" -b white "$svg_abs" -o "$out/figure.png"
fi
mkdir -p -- "$(dirname -- "$dest")"
mv -f -- "$out/figure.png" "$dest"
rmdir "$out"
echo "$dest"
