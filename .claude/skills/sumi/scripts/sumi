#!/bin/sh
# Run the Sumi CLI from this repository's source, from any working directory.
# This script lives at <repo>/.claude/skills/sumi/scripts/sumi. D2 is looked up
# relative to the current directory, so unless SUMI_D2_PATH is already set,
# point it at the repository's managed D2 (installed by `bun run d2:install`).
set -eu
script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repo=$(CDPATH='' cd -- "$script_dir/../../../.." && pwd)
if [ -z "${SUMI_D2_PATH:-}" ] && [ -x "$repo/.sumi/bin/d2" ]; then
  SUMI_D2_PATH="$repo/.sumi/bin/d2"
  export SUMI_D2_PATH
fi
exec bun "$repo/src/cli/index.ts" "$@"
